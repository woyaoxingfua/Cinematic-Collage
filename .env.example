# 在这里填入你的API密钥和服务器地址
# Please fill in your API key and server address here
OPENAI_API_KEY="YOUR_API_KEY_HERE"
OPENAI_API_BASE="YOUR_API_BASE_URL_HERE"

# ---- 可选配置（不填则使用默认值） ----
# Optional settings (defaults apply when omitted)
#
# 【重要】模型必须是支持图片输入的视觉模型（如 Qwen-VL、GLM-4V、GPT-4o 等），
# 纯文本模型无法完成配文任务！
# [IMPORTANT] The model must be a vision model that accepts image input.
#OPENAI_MODEL="stepfun-ai/step3"
#
# AI 请求超时秒数（默认 60）
# Request timeout in seconds (default 60)
#AI_TIMEOUT="60"
#
# AI 回复的最大 token 数（默认 800）
# Max tokens for the AI reply (default 800)
#AI_MAX_TOKENS="800"
